# Database
DATABASE_URL="postgresql://kenji_government:kenji_government@localhost:5436/kenji_government?schema=public"

# Redis
REDIS_URL="redis://localhost:6382"

# MinIO
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="kenji-government"
MINIO_USE_SSL=false

# API
API_PORT=4000
INGEST_PORT=4001
INGEST_ENCRYPTION_KEY="change-me-ingest-encryption-key"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Web session idle timeout (milliseconds) — auto logout when inactive
NEXT_PUBLIC_SESSION_IDLE_MS=1800000

# Pilot testing — disable real email OTP and Google Authenticator
AUTH_EMAIL_OTP_DISABLED=true
AUTH_MFA_DISABLED=true
NEXT_PUBLIC_AUTH_EMAIL_OTP_DISABLED=true
NEXT_PUBLIC_AUTH_MFA_DISABLED=true

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="your-mapbox-public-token"

# Reports — optional SMTP for scheduled report emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@gra.go.ke
# REPORT_STAKEHOLDER_EMAILS=supervisor@gra.go.ke,analyst@gra.go.ke
