<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Remove trailing slashes (if trailingSlash is false, otherwise ignore)
  # But since we use trailingSlash: true, we want to enforce them or just serve the directory
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

# Allow access to everything in the directory
Options -Indexes
Require all granted
