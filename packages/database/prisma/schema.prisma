generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  super_admin
  admin
  supervisor
  analyst
  auditor
}

enum payment_transaction_status {
  pending
  completed
  failed
  refunded
}

enum kyc_status {
  verified
  pending
  flagged
}

enum tax_escrow_status {
  earmarked
  withdrawn
  reversed
}

enum tax_withdrawal_batch_status {
  pending
  completed
  failed
}

enum aml_alert_type {
  velocity
  structuring
  kyc_mismatch
  other
}

enum aml_alert_severity {
  low
  medium
  high
}

enum aml_alert_status {
  open
  reviewed
  escalated
  closed
}

enum operator_status {
  active
  suspended
  revoked
  pending
}

enum compliance_status {
  compliant
  at_risk
  non_compliant
}

enum operator_site_status {
  active
  suspended
}

enum licence_type {
  raffle
  competition
  mixed
}

enum licence_status {
  active
  expired
  suspended
  revoked
}

enum submission_status {
  pending
  approved
  rejected
  revision_requested
}

enum ingest_event_status {
  received
  processing
  processed
  failed
}

enum enforcement_case_type {
  warning
  fine
  investigation
  suspension
}

enum enforcement_case_status {
  open
  resolved
  escalated
  closed
}

enum enforcement_action_type {
  notice
  warning
  fine
  suspension
  revocation
}

enum document_type {
  trading_licence
  registration
  tax_certificate
  audit_report
  insurance
  monthly_return
  bank_statement
  other
}

enum report_category {
  commercial
  compliance
  regional
  payment
  player_safety
}

enum report_run_status {
  queued
  running
  completed
  failed
}

enum report_format {
  csv
  pdf
}

enum player_safety_event_type {
  play_safe
  self_exclusion
  session_end
  stake_placed
}

model users {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  password_hash String
  full_name     String
  role          user_role @default(analyst)
  is_active     Boolean   @default(true)
  mfa_enabled   Boolean   @default(false)
  mfa_secret    String?
  email_otp_new_device_enabled Boolean @default(true)
  last_login_at DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  audit_logs            audit_logs[]
  reviewed_submissions  submissions[] @relation("submission_reviewer")
  opened_cases          enforcement_cases[]
  enforcement_actions   enforcement_actions[]
  uploaded_documents    documents[]
  report_runs           report_runs[]
  system_settings       system_settings[]
  tax_withdrawal_batches tax_withdrawal_batches[]
  reviewed_aml_alerts   aml_alerts[]
  trusted_devices       user_trusted_devices[]
}

model user_trusted_devices {
  id               String   @id @default(uuid()) @db.Uuid
  user_id          String   @db.Uuid
  fingerprint_hash String   @db.VarChar(64)
  user_agent_label String?  @db.VarChar(256)
  last_seen_at     DateTime @default(now()) @db.Timestamptz(6)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, fingerprint_hash])
  @@index([user_id])
}

model audit_logs {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String?  @db.Uuid
  action      String
  entity_type String
  entity_id   String?  @db.Uuid
  metadata    Json?
  ip_address  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user users? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
}

model operators {
  id                   String            @id @default(uuid()) @db.Uuid
  external_id          String            @unique
  legal_name           String
  trading_name         String
  registration_number  String?
  beneficial_owner     String?
  email                String?
  phone                String?
  county               String?
  region               String?
  website              String?
  status               operator_status   @default(active)
  compliance_status    compliance_status @default(compliant)
  risk_score           Int               @default(0)
  annual_ggr           Decimal?          @db.Decimal(18, 2)
  tax_paid             Decimal?          @db.Decimal(18, 2)
  tax_due              Decimal?          @db.Decimal(18, 2)
  monthly_tickets      Int?
  last_submission_at   DateTime?         @db.Timestamptz(6)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @updatedAt @db.Timestamptz(6)

  operator_sites            operator_sites[]
  licences                  licences[]
  submissions               submissions[]
  enforcement_cases         enforcement_cases[]
  documents                 documents[]
  operator_monthly_snapshots operator_monthly_snapshots[]
  live_activity_feed         live_activity_feed[]
  payment_transactions       payment_transactions[]
  aml_alerts                 aml_alerts[]
}

model operator_sites {
  id          String               @id @default(uuid()) @db.Uuid
  operator_id String               @db.Uuid
  domain      String
  site_name   String
  is_primary  Boolean              @default(false)
  status      operator_site_status @default(active)
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  updated_at  DateTime             @updatedAt @db.Timestamptz(6)

  operator        operators         @relation(fields: [operator_id], references: [id], onDelete: Cascade)
  api_credentials           api_credentials[]
  ingest_events             ingest_events[]
  player_safety_events        player_safety_events[]
  session_aggregate_events    session_aggregate_events[]
  payment_transactions        payment_transactions[]

  @@index([operator_id])
}

model licences {
  id             String         @id @default(uuid()) @db.Uuid
  operator_id    String         @db.Uuid
  licence_number String         @unique
  licence_type   licence_type   @default(raffle)
  issued_at      DateTime       @db.Date
  expires_at     DateTime       @db.Date
  status         licence_status @default(active)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @updatedAt @db.Timestamptz(6)

  operator operators @relation(fields: [operator_id], references: [id], onDelete: Cascade)

  @@index([operator_id])
}

model api_credentials {
  id              String    @id @default(uuid()) @db.Uuid
  operator_site_id String   @db.Uuid
  api_key_hash    String
  api_key_prefix  String
  hmac_secret_hash String
  hmac_secret_encrypted String?
  allowed_ips     Json?
  is_active       Boolean   @default(true)
  last_used_at    DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @updatedAt @db.Timestamptz(6)

  operator_site operator_sites @relation(fields: [operator_site_id], references: [id], onDelete: Cascade)

  @@index([operator_site_id])
}

model reporting_periods {
  id        String   @id @default(uuid()) @db.Uuid
  year      Int
  month     Int
  label     String
  starts_at DateTime @db.Date
  ends_at   DateTime @db.Date

  submissions                submissions[]
  operator_monthly_snapshots operator_monthly_snapshots[]
  player_safety_aggregates   player_safety_aggregates[]

  @@unique([year, month])
}

model submissions {
  id                   String            @id @default(uuid()) @db.Uuid
  operator_id          String            @db.Uuid
  reporting_period_id  String            @db.Uuid
  tickets_sold         BigInt            @default(0)
  gross_revenue        Decimal           @default(0) @db.Decimal(18, 2)
  prizes_paid          Decimal           @default(0) @db.Decimal(18, 2)
  expenses             Decimal           @default(0) @db.Decimal(18, 2)
  gross_gaming_revenue Decimal           @default(0) @db.Decimal(18, 2)
  tax_due              Decimal           @default(0) @db.Decimal(18, 2)
  tax_paid             Decimal           @default(0) @db.Decimal(18, 2)
  tax_outstanding      Decimal           @default(0) @db.Decimal(18, 2)
  status               submission_status @default(pending)
  submitted_at         DateTime?         @db.Timestamptz(6)
  reviewed_by          String?           @db.Uuid
  reviewed_at          DateTime?         @db.Timestamptz(6)
  notes                String?
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @updatedAt @db.Timestamptz(6)

  operator          operators         @relation(fields: [operator_id], references: [id], onDelete: Cascade)
  reporting_period  reporting_periods @relation(fields: [reporting_period_id], references: [id])
  reviewer          users?            @relation("submission_reviewer", fields: [reviewed_by], references: [id])
  documents           documents[]

  @@index([operator_id])
  @@index([status])
}

model ingest_events {
  id               String              @id @default(uuid()) @db.Uuid
  operator_site_id String              @db.Uuid
  event_type       String
  idempotency_key  String              @unique
  raw_payload      Json
  status           ingest_event_status @default(received)
  error_message    String?
  processed_at     DateTime?           @db.Timestamptz(6)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)

  operator_site operator_sites @relation(fields: [operator_site_id], references: [id], onDelete: Cascade)

  @@index([operator_site_id])
  @@index([status])
}

model live_activity_feed {
  id          String   @id @default(uuid()) @db.Uuid
  operator_id String   @db.Uuid
  event_type  String
  summary     String
  amount      Decimal? @db.Decimal(18, 2)
  metadata    Json     @default("{}")
  occurred_at DateTime @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  operator operators @relation(fields: [operator_id], references: [id], onDelete: Cascade)

  @@index([operator_id, occurred_at])
  @@index([occurred_at])
}

model enforcement_cases {
  id          String                  @id @default(uuid()) @db.Uuid
  operator_id String                  @db.Uuid
  case_number String                  @unique
  case_type   enforcement_case_type
  title       String
  description String?
  status      enforcement_case_status @default(open)
  metadata    Json                    @default("{}")
  opened_by   String?                 @db.Uuid
  resolved_at DateTime?               @db.Timestamptz(6)
  created_at  DateTime                @default(now()) @db.Timestamptz(6)
  updated_at  DateTime                @updatedAt @db.Timestamptz(6)

  operator  operators             @relation(fields: [operator_id], references: [id], onDelete: Cascade)
  opener    users?                @relation(fields: [opened_by], references: [id])
  actions   enforcement_actions[]

  @@index([operator_id])
  @@index([status])
}

model enforcement_actions {
  id                  String                  @id @default(uuid()) @db.Uuid
  enforcement_case_id String                  @db.Uuid
  action_type         enforcement_action_type
  details             String?
  fine_amount         Decimal?                @db.Decimal(18, 2)
  performed_by        String?                 @db.Uuid
  created_at          DateTime                @default(now()) @db.Timestamptz(6)

  case       enforcement_cases @relation(fields: [enforcement_case_id], references: [id], onDelete: Cascade)
  performer  users?            @relation(fields: [performed_by], references: [id])
}

model documents {
  id            String        @id @default(uuid()) @db.Uuid
  operator_id   String        @db.Uuid
  submission_id String?       @db.Uuid
  document_type document_type
  title         String
  file_path     String
  file_size     BigInt?
  mime_type     String?
  uploaded_by   String?       @db.Uuid
  uploaded_at   DateTime      @default(now()) @db.Timestamptz(6)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)

  operator   operators    @relation(fields: [operator_id], references: [id], onDelete: Cascade)
  submission submissions? @relation(fields: [submission_id], references: [id], onDelete: SetNull)
  uploader   users?       @relation(fields: [uploaded_by], references: [id])

  @@index([operator_id])
  @@index([submission_id])
}

model operator_monthly_snapshots {
  id                   String   @id @default(uuid()) @db.Uuid
  operator_id          String   @db.Uuid
  reporting_period_id  String   @db.Uuid
  gross_gaming_revenue Decimal  @default(0) @db.Decimal(18, 2)
  tax_paid             Decimal  @default(0) @db.Decimal(18, 2)
  tickets_sold         BigInt   @default(0)
  updated_at           DateTime @updatedAt @db.Timestamptz(6)

  operator         operators         @relation(fields: [operator_id], references: [id], onDelete: Cascade)
  reporting_period reporting_periods @relation(fields: [reporting_period_id], references: [id])

  @@unique([operator_id, reporting_period_id])
}

model report_definitions {
  id                 String          @id @default(uuid()) @db.Uuid
  slug               String          @unique
  title              String
  description        String?
  category           report_category
  required_role      user_role       @default(analyst)
  parameters_schema  Json            @default("{}")
  is_scheduled       Boolean         @default(false)
  schedule_recipients Json?
  schedule_cadence   String?
  created_at         DateTime        @default(now()) @db.Timestamptz(6)

  report_runs report_runs[]
}

model report_runs {
  id                    String             @id @default(uuid()) @db.Uuid
  report_definition_id  String             @db.Uuid
  requested_by          String?            @db.Uuid
  parameters            Json               @default("{}")
  format                report_format      @default(csv)
  file_path             String?
  status                report_run_status  @default(queued)
  error_message         String?
  is_scheduled          Boolean            @default(false)
  completed_at          DateTime?          @db.Timestamptz(6)
  created_at            DateTime           @default(now()) @db.Timestamptz(6)

  report_definition report_definitions @relation(fields: [report_definition_id], references: [id], onDelete: Cascade)
  requester         users?             @relation(fields: [requested_by], references: [id], onDelete: SetNull)

  @@index([report_definition_id])
  @@index([status])
  @@index([created_at])
}

model player_safety_events {
  id                String                   @id @default(uuid()) @db.Uuid
  operator_site_id  String                   @db.Uuid
  event_type        player_safety_event_type
  county            String
  region            String?
  hour_of_day       Int
  day_of_week       Int
  stake_amount_band String?
  occurred_at       DateTime                 @db.Timestamptz(6)
  created_at        DateTime                 @default(now()) @db.Timestamptz(6)

  operator_site operator_sites @relation(fields: [operator_site_id], references: [id], onDelete: Cascade)

  @@index([county, occurred_at])
  @@index([operator_site_id, occurred_at])
  @@index([event_type, occurred_at])
}

model session_aggregate_events {
  id                      String   @id @default(uuid()) @db.Uuid
  operator_site_id        String   @db.Uuid
  county                  String
  region                  String?
  bucket_start            DateTime @db.Timestamptz(6)
  day_of_week             Int
  hour_of_day             Int
  session_count           BigInt   @default(0)
  total_session_minutes   BigInt   @default(0)
  stake_band_distribution Json     @default("{}")
  age_band_distribution   Json     @default("{}")
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  operator_site operator_sites @relation(fields: [operator_site_id], references: [id], onDelete: Cascade)

  @@unique([operator_site_id, county, bucket_start])
  @@index([county, bucket_start])
}

model player_safety_aggregates {
  id                      String    @id @default(uuid()) @db.Uuid
  reporting_period_id     String?   @db.Uuid
  bucket_date             DateTime  @db.Date
  county                  String
  region                  String?
  play_safe_activations   BigInt    @default(0)
  self_exclusion_requests BigInt    @default(0)
  session_count           BigInt    @default(0)
  avg_session_minutes     Decimal   @default(0) @db.Decimal(10, 2)
  peak_hour               Int?
  stake_band_distribution Json      @default("{}")
  age_band_distribution   Json      @default("{}")
  hour_by_day_matrix      Json      @default("{}")
  updated_at              DateTime  @updatedAt @db.Timestamptz(6)

  reporting_period reporting_periods? @relation(fields: [reporting_period_id], references: [id], onDelete: SetNull)

  @@unique([bucket_date, county])
  @@index([county])
  @@index([bucket_date])
}

model system_settings {
  key        String   @id
  value      Json
  updated_by String?  @db.Uuid
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  updater users? @relation(fields: [updated_by], references: [id], onDelete: SetNull)
}

model payment_transactions {
  id                      String                     @id @default(uuid()) @db.Uuid
  external_transaction_id String                     @unique
  operator_id             String                     @db.Uuid
  operator_site_id        String                     @db.Uuid
  ticket_reference        String?
  gross_amount            Decimal                    @db.Decimal(18, 2)
  operator_amount         Decimal                    @db.Decimal(18, 2)
  tax_amount              Decimal                    @db.Decimal(18, 2)
  tax_rate                Decimal                    @db.Decimal(5, 4)
  currency                String                     @default("KES")
  status                  payment_transaction_status @default(pending)
  kyc_status              kyc_status                 @default(pending)
  aml_risk_score          Int                        @default(0)
  payer_fingerprint       String?
  county                  String?
  completed_at            DateTime?                  @db.Timestamptz(6)
  created_at              DateTime                   @default(now()) @db.Timestamptz(6)

  operator       operators       @relation(fields: [operator_id], references: [id], onDelete: Cascade)
  operator_site  operator_sites  @relation(fields: [operator_site_id], references: [id], onDelete: Cascade)
  tax_escrow_entries tax_escrow_entries[]
  aml_alerts     aml_alerts[]

  @@index([operator_id])
  @@index([operator_site_id])
  @@index([status])
  @@index([completed_at])
  @@index([created_at])
}

model tax_escrow_entries {
  id                     String            @id @default(uuid()) @db.Uuid
  payment_transaction_id String            @db.Uuid
  tax_amount             Decimal           @db.Decimal(18, 2)
  status                 tax_escrow_status @default(earmarked)
  earmarked_at           DateTime          @default(now()) @db.Timestamptz(6)
  withdrawal_batch_id    String?           @db.Uuid
  created_at             DateTime          @default(now()) @db.Timestamptz(6)

  payment_transaction payment_transactions    @relation(fields: [payment_transaction_id], references: [id], onDelete: Cascade)
  withdrawal_batch    tax_withdrawal_batches? @relation(fields: [withdrawal_batch_id], references: [id], onDelete: SetNull)

  @@index([payment_transaction_id])
  @@index([status])
  @@index([withdrawal_batch_id])
}

model tax_withdrawal_batches {
  id                      String                      @id @default(uuid()) @db.Uuid
  business_date           DateTime                    @db.Date
  total_amount            Decimal                     @db.Decimal(18, 2)
  destination_account_ref String
  gateway_batch_id        String?
  status                  tax_withdrawal_batch_status @default(pending)
  initiated_by            String?                     @db.Uuid
  completed_at            DateTime?                   @db.Timestamptz(6)
  created_at              DateTime                    @default(now()) @db.Timestamptz(6)

  initiator users?              @relation(fields: [initiated_by], references: [id], onDelete: SetNull)
  entries   tax_escrow_entries[]

  @@index([business_date])
  @@index([status])
}

model aml_alerts {
  id                     String             @id @default(uuid()) @db.Uuid
  payment_transaction_id String?            @db.Uuid
  operator_id            String             @db.Uuid
  alert_type             aml_alert_type
  severity               aml_alert_severity
  details                Json               @default("{}")
  status                 aml_alert_status   @default(open)
  reviewed_by            String?            @db.Uuid
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  updated_at             DateTime           @updatedAt @db.Timestamptz(6)

  payment_transaction payment_transactions? @relation(fields: [payment_transaction_id], references: [id], onDelete: SetNull)
  operator            operators             @relation(fields: [operator_id], references: [id], onDelete: Cascade)
  reviewer            users?                @relation(fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([operator_id])
  @@index([status])
  @@index([severity])
  @@index([created_at])
}
