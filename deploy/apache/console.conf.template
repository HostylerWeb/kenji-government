# GRA staff console — main domain (Apache + Let's Encrypt)
<VirtualHost *:443>
    ServerName srv1781529.hstgr.cloud

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/srv1781529.hstgr.cloud/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/srv1781529.hstgr.cloud/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"

    # Staff API
    ProxyPass /api/ http://127.0.0.1:4000/
    ProxyPassReverse /api/ http://127.0.0.1:4000/

    # Next.js web app
    ProxyPass / http://127.0.0.1:3000/
    ProxyPassReverse / http://127.0.0.1:3000/

    ErrorLog ${APACHE_LOG_DIR}/gra-console-error.log
    CustomLog ${APACHE_LOG_DIR}/gra-console-access.log combined
</VirtualHost>

# Redirect HTTP to HTTPS on main domain
<VirtualHost *:80>
    ServerName srv1781529.hstgr.cloud
    Redirect permanent / https://srv1781529.hstgr.cloud/
</VirtualHost>
