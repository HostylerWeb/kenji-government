# GRA staff console — console.force42.com (Apache + Cloudflare origin cert)
<VirtualHost *:443>
    ServerName console.force42.com

    SSLEngine on
    SSLCertificateFile /etc/ssl/cloudflare/force42.pem
    SSLCertificateKeyFile /etc/ssl/cloudflare/force42.key

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Host "console.force42.com"

    ProxyPass /api/ http://127.0.0.1:4000/
    ProxyPassReverse /api/ http://127.0.0.1:4000/

    ProxyPass / http://127.0.0.1:3000/
    ProxyPassReverse / http://127.0.0.1:3000/

    ErrorLog ${APACHE_LOG_DIR}/gra-force42-console-error.log
    CustomLog ${APACHE_LOG_DIR}/gra-force42-console-access.log combined
</VirtualHost>
